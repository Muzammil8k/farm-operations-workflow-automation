    {
      "parameters": {
        "jsCode": "\nconst data = $json.body ?? $json;\n\nconst required = [\n  \"pond_id\",\n  \"record_date\",\n  \"temperature_c\",\n  \"dissolved_oxygen_mg_l\",\n  \"feed_kg\"\n];\n\nconst missing = required.filter(\n  key => data[key] === undefined ||\n         data[key] === null ||\n         String(data[key]).trim() === \"\"\n);\n\nconst temperature = Number(data.temperature_c);\nconst oxygen = Number(data.dissolved_oxygen_mg_l);\nconst feed = Number(data.feed_kg);\n\nconst numericValid =\n  Number.isFinite(temperature) &&\n  Number.isFinite(oxygen) &&\n  Number.isFinite(feed);\n\nconst rangesValid = numericValid &&\n  temperature >= 0 && temperature <= 50 &&\n  oxygen >= 0 && oxygen <= 30 &&\n  feed >= 0;\n\nconst is_valid = missing.length === 0 && rangesValid;\n\nlet alert_status = \"Normal\";\n\nif (is_valid && oxygen < 5) {\n  alert_status = \"Low dissolved oxygen\";\n} else if (is_valid && temperature > 35) {\n  alert_status = \"High temperature\";\n}\n\nconst record_id = [\n  String(data.pond_id ?? \"\").trim(),\n  String(data.record_date ?? \"\").trim()\n].join(\"_\");\n\nreturn {\n  json: {\n    record_id,\n    submitted_at: new Date().toISOString(),\n    pond_id: String(data.pond_id ?? \"\").trim(),\n    record_date: data.record_date ?? \"\",\n    temperature_c: numericValid ? temperature : null,\n    dissolved_oxygen_mg_l: numericValid ? oxygen : null,\n    feed_kg: numericValid ? feed : null,\n    validation_status: is_valid\n      ? \"Valid\"\n      : `Invalid: ${\n          missing.length\n            ? \"Missing \" + missing.join(\", \")\n            : \"Invalid numeric value or out-of-range measurement\"\n        }`,\n    is_valid,\n    alert_status: is_valid ? alert_status : \"Not evaluated\"\n  }\n};\n"
      },
